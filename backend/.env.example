# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stranded_capacity_db
DB_USER=postgres
DB_PASSWORD=your_password

# Sequelize
DB_DIALECT=postgres
DB_LOGGING=false

# Share Tokens (uso futuro)
SHARE_TOKEN_SECRET=your_share_token_secret

# Email (uso futuro)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=example@email.com
SMTP_PASSWORD=your_password
SMTP_FROM=noreply@physaflow.com

# Frontend
FRONTEND_URL=http://localhost:3001

# Swagger
SWAGGER_ENABLED=true
